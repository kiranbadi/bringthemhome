{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bring Them Home Natural Search Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["query", "mode", "filters", "page", "page_size"],
  "properties": {
    "query": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
    "mode": { "enum": ["semantic", "exact"] },
    "page": { "type": "integer", "minimum": 1 },
    "page_size": { "type": "integer", "minimum": 1, "maximum": 100 },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "city": { "type": "string", "minLength": 1, "maxLength": 200 },
        "age_min": { "type": "integer", "minimum": 0, "maximum": 130 },
        "age_max": { "type": "integer", "minimum": 0, "maximum": 130 },
        "gender": { "enum": ["female", "male", "nonbinary", "unknown"] },
        "date_last_seen_after": { "type": "string", "format": "date" },
        "date_last_seen_before": { "type": "string", "format": "date" }
      }
    }
  }
}
